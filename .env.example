# Copy to ".env". The app runs fully WITHOUT these via a local fallback engine,
# so you can build and demo on day 1, then flip USE_DWS=true once wired.

USE_DWS=false

# Nutrient DWS keys — from your DWS dashboard (nutrient.io/api).
# DWS_API_KEY is the Processor key (redact / sign).
# DWS_EXTRACT_API_KEY is the separate Data Extraction key (parse); optional.
DWS_API_KEY=your_processor_key_here
DWS_EXTRACT_API_KEY=

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000
STORAGE_DIR=storage
